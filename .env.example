NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only Supabase credential.
SUPABASE_SECRET_KEY=your_supabase_secret_here

# Stripe restricted production API key.
STRIPE_RESTRICTED_KEY=your_stripe_restricted_key_here
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here

# Long random secret used to protect scheduled jobs.
CRON_SECRET=your_random_cron_secret_here

# Optional until email delivery is enabled.
RESEND_API_KEY=
EMAIL_FROM="ProjectSignal <leads@your-domain.co.uk>"
